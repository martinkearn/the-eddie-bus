# Next.js public environment variables (used at build/runtime in the browser)
# Required for booking form API submission:
NEXT_PUBLIC_BOOKING_API_ENDPOINT=http://127.0.0.1:8080/bookings/create.php

# Optional: set only when availability endpoint is NOT derivable from the create endpoint.
# Most setups on the same host do not need this.
# NEXT_PUBLIC_BOOKING_AVAILABILITY_ENDPOINT=http://127.0.0.1:8080/bookings/availability.php

# Optional: override admin API base when it differs from derivation rules.
# NEXT_PUBLIC_ADMIN_API_BASE=http://127.0.0.1:8080/admin

# Backend PHP DB config
# Prefer backend/config.private.php for local development with npm run dev.
# If you do not use backend/config.private.php, set DB_HOST/DB_NAME/DB_USER/DB_PASS
# in the shell/environment where the PHP server is started.
